# Server Configuration
PORT=5001
NODE_ENV=development

# Turso / libSQL Database Connection
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# JWT Session Secrets (Use strong random secrets in production)
JWT_SECRET=your_secure_jwt_access_token_secret
JWT_REFRESH_SECRET=your_secure_jwt_refresh_token_secret

# Client Application URL (For CORS allow-list)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 / Google Identity Services (GIS)
# Created in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary (Optional - local filesystem fallback works automatically if blank)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Optional - test simulator works automatically if blank)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
