{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path((?!health$|auth/login$|admin/login$|express$).*)",
      "destination": "/api/express?__dulia_route=:path"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm install --omit=dev && npm ci --prefix frontend --include=dev && npm ci --prefix backend"
}
